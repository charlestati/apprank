{
	"name": "apprank",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
		"types": "pnpm --filter collector --filter web types",
		"typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
		"lint": "ultracite check",
		"lint:fix": "ultracite fix",
		"test": "pnpm -r test && pnpm test:scripts",
		"coverage": "pnpm -r coverage",
		"generate": "pnpm --filter @apprank/core generate",
		"migrate:local": "pnpm --filter collector migrate:local",
		"migrate:remote": "pnpm --filter collector migrate:remote",
		"seed:local": "pnpm --filter collector seed:local",
		"seed:remote": "pnpm --filter collector seed:remote",
		"deploy": "pnpm --filter collector deploy && pnpm --filter web deploy",
		"track": "node scripts/track/track.mjs",
		"rebuild:d1": "pnpm --filter rebuild-d1 start",
		"rank-churn": "node scripts/rank-churn/measure.mjs",
		"test:scripts": "node --test \"scripts/**/*.test.mjs\"",
		"relevance": "pnpm --filter keyword-relevance score",
		"knip": "knip",
		"ci": "pnpm lint && pnpm knip && pnpm typecheck && pnpm coverage && pnpm test:scripts"
	},
	"devDependencies": {
		"knip": "6.41.0",
		"oxfmt": "0.73.0",
		"oxlint": "1.88.0",
		"typescript": "catalog:",
		"ultracite": "8.0.0"
	},
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"packageManager": "pnpm@12.13.0"
}
