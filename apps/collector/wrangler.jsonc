{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "apprank-collector",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	// COLLECTION_MODE defaults to "all" — collect everything. Set it to
	// "credentialed" (App Store Connect and Apple Ads only) on a deployment whose
	// egress Apple's public iTunes endpoints reject, which is every Cloudflare
	// Worker: the 429s are not free, each one feeds the daily tally that halves
	// the learned rate. This operator sets it in the gitignored
	// wrangler.local.jsonc; rank crawls run from a borrowed IP instead
	// (scripts/local-refresh, .github/workflows/collect.yml).
	"triggers": {
		// Watchdog: re-arms the SchedulerDO alarm if it was lost (rare DO eviction).
		// Daily: 03:00 UTC dispatches ASC poll / Ads pull / compaction / prune.
		"crons": ["*/10 * * * *", "0 3 * * *"],
	},
	"durable_objects": {
		"bindings": [{ "name": "SCHEDULER", "class_name": "SchedulerDO" }],
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["SchedulerDO"] }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "apprank",
			// Per-deployment value. Copy this file to wrangler.local.jsonc (gitignored)
			// and paste the id from `wrangler d1 create apprank`; the npm scripts pick
			// the local file up automatically.
			"database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
			"migrations_dir": "../../packages/core/migrations",
		},
	],
	"r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "apprank-archive" }],
	"observability": { "enabled": true },
}
