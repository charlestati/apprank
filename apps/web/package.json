{
	"name": "web",
	"private": true,
	"type": "module",
	"scripts": {
		"types": "wrangler types",
		"typecheck": "wrangler types && tsc -p tsconfig.json && tsc -p client/tsconfig.json",
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"dev": "vite dev",
		"build": "vite build",
		"deploy": "pnpm run build && wrangler deploy -c $(test -f wrangler.local.jsonc && echo wrangler.local.jsonc || echo wrangler.jsonc)",
		"dev:worker": "wrangler dev -c $(test -f wrangler.local.jsonc && echo wrangler.local.jsonc || echo wrangler.jsonc) --var ALLOW_UNAUTHENTICATED:true"
	},
	"dependencies": {
		"@apprank/core": "workspace:*",
		"@base-ui/react": "1.9.0",
		"@fontsource-variable/inter": "5.3.0",
		"@modelcontextprotocol/client": "2.3.1",
		"@modelcontextprotocol/sdk": "1.32.1",
		"@modelcontextprotocol/server": "2.3.1",
		"agents": "0.28.1",
		"hono": "4.13.16",
		"lucide-react": "1.56.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-router": "8.4.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "catalog:",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"@vitest/coverage-istanbul": "catalog:",
		"happy-dom": "21.0.1",
		"typescript": "catalog:",
		"vite": "8.3.4",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	}
}
