{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "apprank-web",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	// The MCP server is built on the Agents SDK, which imports node:async_hooks.
	// Without this flag the deploy fails outright with `No such module`. The flag
	// itself costs nothing; watch the deploy size instead.
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// The Worker gates the whole origin: a browser will not show its
		// credential prompt for a failed fetch(), so the HTML has to be behind the
		// same wall as the API. Asset requests therefore cost Worker invocations, roughly one per page load, which is nothing at this scale.
		"run_worker_first": true,
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "apprank",
			"migrations_dir": "../../packages/core/migrations",
			// Per-deployment value. Copy this file to wrangler.local.jsonc (gitignored)
			// and paste the id from `wrangler d1 create apprank`; the npm scripts pick
			// the local file up automatically.
			"database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
		},
	],
	"r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "apprank-archive" }],
	// Burst brake for the MCP endpoint, keyed per credential. The authoritative
	// limit is the daily budget on `mcp_credential`; this one only stops a hot
	// retry loop from reaching D1 at all. `period` accepts 10 or 60 seconds only.
	"ratelimits": [
		{
			"name": "MCP_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 30, "period": 60 },
		},
	],
	"vars": {
		// The public origin of this deployment.
		"APP_URL": "https://apprank.example",
		// The MCP endpoint at /mcp is opt-in. Uncomment to publish it.
		// "MCP_ENABLED": "true",
	},
	"observability": { "enabled": true },
}
