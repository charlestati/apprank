{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "apprank-web",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true,
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "apprank",
			"migrations_dir": "../../packages/core/migrations",
			// Per-deployment value. Copy this file to wrangler.local.jsonc (gitignored)
			// and paste the id from `wrangler d1 create apprank`; the npm scripts pick
			// the local file up automatically.
			"database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
		},
	],
	// No R2 binding on purpose: this Worker only reads D1, and the archive is the
	// source of truth, so the public-facing half holds no handle to it.
	//
	// Burst brake for the MCP endpoint, charged twice under different keys: per
	// client address before the credential is checked, per credential after. The
	// authoritative limit is the daily budget on `mcp_credential`; this one only
	// stops a hot retry loop from reaching D1. `period` accepts 10 or 60 seconds
	// only.
	"ratelimits": [
		{
			"name": "MCP_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 30, "period": 60 },
		},
	],
	"vars": {
		// The MCP endpoint at /mcp is opt-in. Uncomment to publish it.
		// "MCP_ENABLED": "true",
	},
	"observability": { "enabled": true },
}
